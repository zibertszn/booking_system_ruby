<!-- app/views/chat_messages/_message.html.erb — Сообщение в диалоге 1-на-1 -->
<div id="<%= dom_id(message) %>" class="flex flex-col space-y-1 transition-all">
  <div class="flex items-center gap-2 text-xs">
    <span class="font-semibold text-slate-800">
      <%= message.user&.name || "Пользователь" %>
    </span>
    <% if message.user_id == message.chat_room.owner_id %>
      <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-amber-50 text-amber-800 border border-amber-200">
        Владелец объявления
      </span>
    <% else %>
      <span class="px-1.5 py-0.5 rounded text-[10px] font-medium bg-sky-50 text-sky-800 border border-sky-200">
        Заказчик
      </span>
    <% end %>
    <span class="text-[11px] text-slate-400 font-mono">
      <%= message.created_at ? message.created_at.strftime("%H:%M") : Time.current.strftime("%H:%M") %>
    </span>
  </div>
  <div class="p-3 rounded-xl max-w-xl text-sm leading-relaxed bg-white border border-slate-200 text-slate-900 shadow-sm rounded-tl-sm">
    <p class="whitespace-pre-wrap break-words"><%= message.content %></p>
  </div>
</div>
