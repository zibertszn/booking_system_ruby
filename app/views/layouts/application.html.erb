<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Booking System — Сервис бронирования ресурсов</title>
    <meta name="description" content="Сервис бронирования переговорных комнат, оборудования и специалистов.">
    <meta property="og:title" content="Booking System — Сервис бронирования ресурсов">
    <meta property="og:description" content="Сервис бронирования переговорных комнат, оборудования и специалистов.">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= action_cable_meta_tag %>
    <%= javascript_importmap_tags %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;600&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: ['"DM Sans"', 'sans-serif'],
              display: ['"Plus Jakarta Sans"', 'sans-serif'],
              mono: ['"JetBrains Mono"', 'monospace']
            }
          }
        }
      }
    </script>
    <script src="/vendor/vue.global.prod.js"></script>
    <script>
      if (typeof Vue === 'undefined') {
        document.write('<script src="https://unpkg.com/vue@3/dist/vue.global.prod.js"><\/script>');
      }
    </script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
    <style>[x-cloak] { display: none !important; }</style>
  </head>

  <body class="bg-slate-50 text-slate-900 font-sans antialiased min-h-screen flex flex-col">
    <!-- Top Bar Contract: 3 zones separated by gap-8 -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between gap-8">
        <!-- Zone 1: Single text element wordmark -->
        <a href="/resources" class="font-display text-lg font-bold tracking-tight text-slate-900 whitespace-nowrap shrink-0">
          BookingSystem
        </a>

        <!-- Zone 2: Navigation links -->
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-600">
          <a href="/resources" class="hover:text-slate-900 hover:underline underline-offset-4 transition-colors whitespace-nowrap shrink-0">
            Каталог
          </a>
          <a href="/bookings" class="hover:text-slate-900 hover:underline underline-offset-4 transition-colors whitespace-nowrap shrink-0">
            Мои бронирования (<span class="font-mono tabular-nums"><%= @active_bookings_count || 0 %></span>)
          </a>
          <a href="/my_resources" class="hover:text-slate-900 hover:underline underline-offset-4 transition-colors whitespace-nowrap shrink-0">
            Мои объявления (<span class="font-mono tabular-nums"><%= @my_resources_count || 0 %></span>)
          </a>
          <a href="/chat" class="hover:text-slate-900 hover:underline underline-offset-4 transition-colors whitespace-nowrap shrink-0 flex items-center gap-1.5">
            <span>Чат</span>
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          </a>
        </nav>

        <!-- Zone 3: 1 primary action -->
        <div class="flex items-center shrink-0">
          <% if user_signed_in? %>
            <div class="relative" x-data="{ open: false }">
              <button @click="open = !open" @keydown.escape="open = false"
                      class="flex items-center gap-2 px-4 py-2 text-xs font-semibold text-slate-800 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors whitespace-nowrap">
                <span><%= current_user.name %></span>
                <svg class="w-3.5 h-3.5 text-slate-500 transition-transform" :class="{ 'rotate-180': open }" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                </svg>
              </button>
              <div x-show="open" x-cloak @click.outside="open = false"
                   x-transition:enter="transition ease-out duration-100"
                   x-transition:enter-start="opacity-0 scale-95"
                   x-transition:enter-end="opacity-100 scale-100"
                   x-transition:leave="transition ease-in duration-75"
                   x-transition:leave-start="opacity-100 scale-100"
                   x-transition:leave-end="opacity-0 scale-95"
                   class="absolute right-0 mt-2 w-48 bg-white rounded-xl shadow-lg border border-slate-200 py-1 z-50">
                <div class="px-4 py-2.5 border-b border-slate-100">
                  <p class="text-xs font-semibold text-slate-900 truncate"><%= current_user.name %></p>
                  <p class="text-xs text-slate-500 truncate"><%= current_user.email %></p>
                </div>
                <%= link_to "Мои бронирования", bookings_path,
                      class: "flex items-center gap-2 px-4 py-2.5 text-xs text-slate-700 hover:bg-slate-50 transition-colors" %>
                <%= link_to "Мои объявления", my_resources_path,
                      class: "flex items-center gap-2 px-4 py-2.5 text-xs text-slate-700 hover:bg-slate-50 transition-colors" %>
                <%= link_to "Онлайн-чат", chat_path,
                      class: "flex items-center gap-2 px-4 py-2.5 text-xs text-slate-700 hover:bg-slate-50 transition-colors" %>
                <div class="border-t border-slate-100 mt-1 pt-1">
                  <%= button_to "Выйти из аккаунта", destroy_user_session_path, method: :delete,
                        class: "w-full flex items-center gap-2 px-4 py-2.5 text-xs text-rose-600 hover:bg-rose-50 transition-colors text-left" %>
                </div>
              </div>
            </div>
          <% else %>
            <a href="/users/sign_in" class="px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors whitespace-nowrap shrink-0">
              Войти в аккаунт
            </a>
          <% end %>
        </div>
      </div>
    </header>

    <% if flash[:notice].present? %>
      <div class="max-w-7xl w-full mx-auto px-6 pt-5">
        <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-sm text-emerald-900 flex items-center justify-between">
          <span><%= flash[:notice] %></span>
        </div>
      </div>
    <% end %>

    <% if flash[:alert].present? %>
      <div class="max-w-7xl w-full mx-auto px-6 pt-5">
        <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-sm text-rose-900 flex items-center justify-between">
          <span><%= flash[:alert] %></span>
        </div>
      </div>
    <% end %>

    <main class="flex-1 max-w-7xl w-full mx-auto px-6 py-8">
      <%= yield %>
    </main>

    <footer class="mt-auto border-t border-slate-200 bg-white py-6">
      <div class="max-w-7xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <div>
          BookingSystem · Сервис онлайн-бронирования ресурсов и пространств
        </div>
        <div class="flex items-center gap-4">
          <a href="/resources" class="hover:text-slate-900">Каталог ресурсов</a>
          <span>·</span>
          <a href="/bookings" class="hover:text-slate-900">Мои бронирования</a>
          <span>·</span>
          <a href="/my_resources" class="hover:text-slate-900">Мои объявления</a>
          <span>·</span>
          <a href="/chat" class="hover:text-slate-900">Чат</a>
          <span>·</span>
          <a href="/users/sign_in" class="hover:text-slate-900">Профиль</a>
        </div>
      </div>
    </footer>

    <script src="/assets/components/booking_calendar_widget.js"></script>
  </body>
</html>
