<!-- app/views/bookings/show.html.erb — Детали бронирования -->
<div class="max-w-3xl mx-auto space-y-6">
  <section class="bg-white border border-slate-200 rounded-xl p-6 sm:p-8 space-y-6">
    <div class="border-b border-slate-200 pb-5 flex flex-wrap items-baseline justify-between gap-4">
      <div>
        <div class="text-xs font-semibold text-emerald-700">
          Заявка успешно подтверждена
        </div>
        <h1 class="mt-1 font-display text-2xl font-bold text-slate-900">
          Бронирование <span class="font-mono tabular-nums">#<%= @booking.id %></span> оформлено
        </h1>
      </div>
      <div class="font-mono text-xs text-slate-500 tabular-nums">
        Статус: <%= @booking.status == 'confirmed' ? 'Подтверждено' : 'Отменено' %>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
      <div>
        <div class="text-xs text-slate-500">Объект бронирования</div>
        <div class="font-semibold text-slate-900 mt-0.5"><%= @booking.resource_name %></div>
      </div>

      <div>
        <div class="text-xs text-slate-500">Дата и время</div>
        <div class="font-mono font-semibold text-slate-900 tabular-nums mt-0.5">
          <%= @booking.booking_date %> · <%= @booking.start_time %>–<%= @booking.end_time %> (<%= @booking.duration_hours %> ч.)
        </div>
      </div>

      <div>
        <div class="text-xs text-slate-500">Заказчик и контакты</div>
        <div class="text-slate-900 mt-0.5"><%= @booking.contact_name %> · <%= @booking.contact_email %></div>
      </div>

      <div>
        <div class="text-xs text-slate-500">Итоговая стоимость</div>
        <div class="font-mono text-lg font-bold text-sky-700 tabular-nums mt-0.5">
          <%= number_with_delimiter(@booking.total_price) %> ₽
        </div>
      </div>
    </div>

    <div class="pt-5 border-t border-slate-200">
      <div class="text-xs font-semibold text-slate-700 mb-2">
        Уведомление, отправленное на электронную почту:
      </div>
      <div class="bg-slate-50 border border-slate-200 rounded-lg p-4 font-mono text-xs text-slate-700 space-y-1.5">
        <div><strong>Кому:</strong> <%= @booking.contact_email %></div>
        <div><strong>Тема:</strong> Подтверждение бронирования #<%= @booking.id %> — <%= @booking.resource_name %></div>
        <div class="pt-2 border-t border-slate-200 font-sans text-slate-600">
          Здравствуйте, <%= @booking.contact_name %>! Ваша бронь ресурса «<%= @booking.resource_name %>» на <%= @booking.booking_date %> с <%= @booking.start_time %> до <%= @booking.end_time %> успешно подтверждена. Итоговая сумма: <%= number_with_delimiter(@booking.total_price) %> ₽.
        </div>
      </div>
    </div>

    <div class="pt-4 flex flex-wrap items-center justify-between gap-4">
      <a
        href="/resources"
        class="text-sm font-medium text-slate-600 hover:text-slate-900"
      >
        ← Вернуться в каталог ресурсов
      </a>
      <div class="flex items-center gap-3">
        <%= button_to chat_rooms_path(booking_id: @booking.id),
              method: :post,
              class: "px-4 py-2.5 rounded-lg text-sm font-semibold bg-sky-600 hover:bg-sky-700 text-white transition-colors flex items-center gap-1.5" do %>
          <span>Чат по бронированию</span>
          <span>💬</span>
        <% end %>
        <a
          href="/bookings"
          class="px-5 py-2.5 rounded-lg text-sm font-semibold bg-slate-900 hover:bg-slate-800 text-white transition-colors"
        >
          Перейти в «Мои бронирования»
        </a>
      </div>
    </div>
  </section>
</div>
