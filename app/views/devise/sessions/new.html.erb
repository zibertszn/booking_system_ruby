<!-- app/views/devise/sessions/new.html.erb — Страница авторизации -->
<div class="max-w-xl mx-auto space-y-6">
  <section class="bg-white border border-slate-200 rounded-xl p-6 sm:p-8 space-y-6">
    <div>
      <h1 class="font-display text-2xl font-bold text-slate-900">
        Вход в личный кабинет
      </h1>
      <p class="text-sm text-slate-600 mt-1">
        Войдите по электронной почте и паролю.
      </p>
    </div>

    <%= form_with url: user_session_path, class: "space-y-4" do |f| %>
      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Электронная почта</label>
        <input
          type="email"
          name="user[email]"
          required
          autocomplete="email"
          class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:border-sky-600"
        >
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">Пароль</label>
        <input
          type="password"
          name="user[password]"
          required
          autocomplete="current-password"
          class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:border-sky-600"
        >
      </div>

      <button
        type="submit"
        class="w-full py-2.5 rounded-lg text-sm font-semibold bg-sky-600 hover:bg-sky-700 text-white transition-colors"
      >
        Войти в аккаунт
      </button>
    <% end %>

    <div class="pt-4 border-t border-slate-200 text-center text-sm text-slate-600">
      Нет аккаунта?
      <%= link_to "Зарегистрироваться", new_user_registration_path,
            class: "font-semibold text-sky-600 hover:text-sky-700 hover:underline underline-offset-4" %>
    </div>
  </section>
</div>
