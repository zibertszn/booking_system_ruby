<!-- app/views/resources/new.html.erb — Создание нового ресурса -->
<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between text-xs text-slate-500">
    <div>
      <a href="/resources" class="hover:text-slate-900">Каталог ресурсов</a>
      <span class="mx-2">/</span>
      <span class="text-slate-900 font-medium">Добавление нового ресурса</span>
    </div>
    <a href="/resources" class="text-sky-700 hover:underline font-medium">← Назад в каталог</a>
  </div>

  <section class="bg-white border border-slate-200 rounded-xl p-6 sm:p-8 space-y-6">
    <div class="border-b border-slate-200 pb-4">
      <h1 class="font-display text-2xl font-bold text-slate-900">
        Добавить новый ресурс для бронирования
      </h1>
    </div>

    <form action="/resources" method="post" enctype="multipart/form-data" class="space-y-6">
      <%= token_tag %>

      <div id="vue-new-resource-image">
        <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-800">
              Фотография ресурса *
            </label>
            <p class="text-xs text-slate-500 mt-0.5">
              Загрузите фото со своего компьютера
            </p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 items-center">
            <div class="space-y-3">
              <div>
                <label class="block text-xs font-medium text-slate-700 mb-1">
                  Загрузить файл с компьютера:
                </label>
                <input
                  type="file"
                  name="resource[image_file]"
                  accept="image/*"
                  class="block w-full text-xs text-slate-600 file:mr-3 file:py-2 file:px-3.5 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-sky-600 file:text-white hover:file:bg-sky-700 cursor-pointer"
                >
              </div>

              <input type="hidden" name="resource[image_data]" value="">
            </div>

            <div class="h-52 rounded-lg overflow-hidden bg-slate-900 border border-slate-200 flex items-center justify-center p-2 relative">
              <span class="text-xs text-slate-400 text-center px-4">
                Предпросмотр фотографии появится здесь после выбора файла
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label id="resource_name_label" class="block text-xs font-semibold text-slate-700 mb-1">
            Название помещения *
          </label>
          <input
            type="text"
            name="resource[name]"
            id="resource_name"
            required
            placeholder="Например: Переговорная «Вега»"
            class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:border-sky-600"
          >
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">
            Категория *
          </label>
          <select
            name="resource[category]"
            id="resource_category"
            class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg text-slate-900 bg-white focus:outline-none focus:border-sky-600 transition-colors"
          >
            <option value="rooms" selected>Помещение</option>
            <option value="equipment">Оборудование</option>
            <option value="specialists">Специалисты</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-start">
        <div id="rate_field_container">
          <label id="rate_input_label" class="block text-xs font-semibold text-slate-700 mb-1">
            Ставка (₽) *
          </label>
          <input
            type="number"
            name="resource[hourly_rate]"
            id="resource_hourly_rate"
            required
            min="1"
            step="any"
            value="1500"
            class="w-full px-3.5 py-2 text-sm font-mono tabular-nums border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:border-sky-600"
          >

          <!-- Блок выбора ставки (в час / в день / в месяц / в год) для категорий Помещение и Оборудование -->
          <div id="rate_unit_section" class="mt-2.5 p-2.5 bg-slate-50 border border-slate-200 rounded-lg space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-700">Единица ставки:</span>
              <span id="rate_category_badge" class="text-[10px] font-medium text-sky-700 bg-sky-100/70 px-1.5 py-0.5 rounded">для помещения</span>
            </div>

            <!-- Кнопки выбора ставки (в час / в день / в месяц / в год) -->
            <div class="grid grid-cols-4 gap-1" id="rate_unit_buttons">
              <button
                type="button"
                data-unit="hour"
                class="rate-unit-btn px-1.5 py-1 text-xs font-medium rounded border text-center transition-all bg-sky-600 text-white border-sky-600 shadow-sm"
              >
                в час
              </button>
              <button
                type="button"
                data-unit="day"
                class="rate-unit-btn px-1.5 py-1 text-xs font-medium rounded border text-center transition-all bg-white text-slate-700 border-slate-300 hover:bg-slate-100"
              >
                в день
              </button>
              <button
                type="button"
                data-unit="month"
                class="rate-unit-btn px-1.5 py-1 text-xs font-medium rounded border text-center transition-all bg-white text-slate-700 border-slate-300 hover:bg-slate-100"
              >
                в месяц
              </button>
              <button
                type="button"
                data-unit="year"
                class="rate-unit-btn px-1.5 py-1 text-xs font-medium rounded border text-center transition-all bg-white text-slate-700 border-slate-300 hover:bg-slate-100"
              >
                в год
              </button>
            </div>

            <input type="hidden" name="resource[rate_unit]" id="resource_rate_unit" value="hour">

            <p id="rate_unit_hint" class="text-[11px] text-slate-500 leading-tight">
              Текущий тариф: <strong class="text-slate-800 font-semibold" id="current_rate_preview">1,500 ₽ / час</strong>
            </p>
          </div>
        </div>

        <div id="capacity_field_container">
          <label class="block text-xs font-semibold text-slate-700 mb-1">
            Вместимость (чел.)
          </label>
          <input
            type="number"
            name="resource[capacity]"
            id="resource_capacity"
            min="1"
            max="500"
            value="8"
            class="w-full px-3.5 py-2 text-sm font-mono tabular-nums border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:border-sky-600"
          >
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">
            Локация / Кабинет
          </label>
          <input
            type="text"
            name="resource[location]"
            placeholder="Корпус Б, 2 этаж, зал 204"
            class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:border-sky-600"
          >
        </div>
      </div>

      <!-- Временной промежуток доступности для бронирования -->
      <div class="p-4 sm:p-5 rounded-xl bg-slate-50 border border-slate-200 space-y-4">
        <div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-sky-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider">
              Временной промежуток бронирования
            </h3>
          </div>
          <p class="text-xs text-slate-500 mt-1">
            Укажите часы и диапазон дат, в течение которых заказчики смогут оформить бронирование вашего объявления
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
          <!-- Часы начала и окончания -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">
              Часы доступности (в течение дня) *
            </label>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <span class="text-[11px] text-slate-500 mb-0.5 block">С:</span>
                <select
                  name="resource[available_from_time]"
                  id="resource_available_from_time"
                  required
                  class="w-full px-3 py-2 text-xs font-mono border border-slate-300 rounded-lg text-slate-900 bg-white focus:outline-none focus:border-sky-600"
                >
                  <% (6..22).each do |h| %>
                    <% val = format("%02d:00", h) %>
                    <option value="<%= val %>" <%= 'selected' if val == '09:00' %>><%= val %></option>
                  <% end %>
                </select>
              </div>

              <div>
                <span class="text-[11px] text-slate-500 mb-0.5 block">По:</span>
                <select
                  name="resource[available_to_time]"
                  id="resource_available_to_time"
                  required
                  class="w-full px-3 py-2 text-xs font-mono border border-slate-300 rounded-lg text-slate-900 bg-white focus:outline-none focus:border-sky-600"
                >
                  <% (7..24).each do |h| %>
                    <% val = format("%02d:00", h) %>
                    <option value="<%= val %>" <%= 'selected' if val == '21:00' %>><%= val %></option>
                  <% end %>
                </select>
              </div>
            </div>
            <p class="text-[11px] text-slate-400 mt-1">Только в эти часы будут доступны бронирования в календаре</p>
          </div>

          <!-- Даты начала и окончания -->
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">
              Период дат бронирования (опционально)
            </label>
            <div class="grid grid-cols-2 gap-2">
              <div>
                <span class="text-[11px] text-slate-500 mb-0.5 block">С даты:</span>
                <input
                  type="date"
                  name="resource[available_from_date]"
                  id="resource_available_from_date"
                  class="w-full px-3 py-1.5 text-xs font-mono border border-slate-300 rounded-lg text-slate-900 bg-white focus:outline-none focus:border-sky-600"
                >
              </div>

              <div>
                <span class="text-[11px] text-slate-500 mb-0.5 block">По дату:</span>
                <input
                  type="date"
                  name="resource[available_to_date]"
                  id="resource_available_to_date"
                  class="w-full px-3 py-1.5 text-xs font-mono border border-slate-300 rounded-lg text-slate-900 bg-white focus:outline-none focus:border-sky-600"
                >
              </div>
            </div>
            <p class="text-[11px] text-slate-400 mt-1">Оставьте пустым для бессрочной доступности в любые дни</p>
          </div>
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-700 mb-1">
          Подробное описание ресурса *
        </label>
        <textarea
          name="resource[description]"
          rows="3"
          required
          placeholder="Опишите характеристики помещения, комплектацию оборудования или профиль специалиста..."
          class="w-full px-3.5 py-2 text-sm border border-slate-300 rounded-lg text-slate-900 focus:outline-none focus:border-sky-600"
        ></textarea>
      </div>

      <div class="pt-4 border-t border-slate-200 flex items-center justify-end gap-3">
        <a
          href="/resources"
          class="px-4 py-2 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition-colors"
        >
          Отмена
        </a>
        <button
          type="submit"
          class="px-5 py-2.5 rounded-lg text-sm font-semibold bg-sky-600 hover:bg-sky-700 text-white transition-colors"
        >
          Создать ресурс в каталоге
        </button>
      </div>
    </form>
  </section>
</div>

<script>
  (function () {
    function initRateUnitControls() {
      const categorySelect = document.getElementById("resource_category");
      const rateUnitSection = document.getElementById("rate_unit_section");
      const rateInputLabel = document.getElementById("rate_input_label");
      const rateInput = document.getElementById("resource_hourly_rate");
      const rateUnitHidden = document.getElementById("resource_rate_unit");
      const rateUnitButtons = document.querySelectorAll(".rate-unit-btn");
      const previewEl = document.getElementById("current_rate_preview");
      const badgeEl = document.getElementById("rate_category_badge");
      const nameLabelEl = document.getElementById("resource_name_label");
      const nameInputEl = document.getElementById("resource_name");
      const capacityContainer = document.getElementById("capacity_field_container");
      const capacityInput = document.getElementById("resource_capacity");

      if (!categorySelect || !rateUnitSection || !rateUnitHidden) return;

      const categoryNameLabels = {
        rooms: {
          label: "Название помещения *",
          placeholder: "Например: Переговорная «Вега»"
        },
        equipment: {
          label: "Название оборудования *",
          placeholder: "Например: Комплект съемки Sony A7 IV"
        },
        specialists: {
          label: "Название специалиста *",
          placeholder: "Например: Консультация звукорежиссера"
        }
      };

      const unitLabels = {
        hour: "час",
        day: "день",
        month: "месяц",
        year: "год"
      };

      const defaultSuggestions = {
        rooms: {
          hour: 1500,
          day: 8000,
          month: 60000,
          year: 600000
        },
        equipment: {
          hour: 1200,
          day: 4500,
          month: 30000,
          year: 300000
        }
      };

      function updatePreview() {
        if (!previewEl) return;
        const val = parseInt(rateInput.value, 10) || 0;
        const unit = rateUnitHidden.value || "hour";
        const formatted = new Intl.NumberFormat("ru-RU").format(val);
        previewEl.textContent = formatted + " ₽ / " + (unitLabels[unit] || "час");
      }

      function syncRateUnit(unit, updateSuggestedValue) {
        rateUnitHidden.value = unit;

        rateUnitButtons.forEach(function (btn) {
          if (btn.dataset.unit === unit) {
            btn.className = "rate-unit-btn px-1.5 py-1 text-xs font-medium rounded border text-center transition-all bg-sky-600 text-white border-sky-600 shadow-sm";
          } else {
            btn.className = "rate-unit-btn px-1.5 py-1 text-xs font-medium rounded border text-center transition-all bg-white text-slate-700 border-slate-300 hover:bg-slate-100";
          }
        });

        if (updateSuggestedValue) {
          const cat = categorySelect.value;
          const suggestions = defaultSuggestions[cat] || defaultSuggestions.rooms;
          if (suggestions && suggestions[unit]) {
            const currentVal = parseInt(rateInput.value, 10);
            const allDefaults = Object.values(suggestions);
            if (!currentVal || allDefaults.includes(currentVal)) {
              rateInput.value = suggestions[unit];
            }
          }
        }

        updatePreview();
      }

      function onCategoryChange() {
        const cat = categorySelect.value;
        const isApplicable = cat === "rooms" || cat === "equipment";

        // Оглавление и плейсхолдер поля названия ресурса по выбранной категории
        const nameConfig = categoryNameLabels[cat] || {
          label: "Название ресурса *",
          placeholder: "Например: Переговорная «Вега»"
        };
        if (nameLabelEl) nameLabelEl.textContent = nameConfig.label;
        if (nameInputEl) nameInputEl.placeholder = nameConfig.placeholder;

        // Поле вместимости отображается только для помещений (скрыто для оборудования и специалистов)
        if (capacityContainer && capacityInput) {
          if (cat === "rooms") {
            capacityContainer.style.display = "block";
            capacityInput.disabled = false;
            if (!capacityInput.value) {
              capacityInput.value = "8";
            }
          } else {
            capacityContainer.style.display = "none";
            capacityInput.disabled = true;
            capacityInput.value = "";
          }
        }

        // Блок выбора периода ставки (для помещений и оборудования)
        if (isApplicable) {
          rateUnitSection.style.display = "block";
          rateInputLabel.textContent = "Ставка (₽) *";
          if (badgeEl) {
            badgeEl.textContent = cat === "rooms" ? "для помещения" : "для оборудования";
          }
        } else {
          rateUnitSection.style.display = "none";
          rateInputLabel.textContent = "Почасовая ставка (₽ / час) *";
          syncRateUnit("hour", false);
        }
      }

      rateUnitButtons.forEach(function (btn) {
        btn.addEventListener("click", function () {
          syncRateUnit(btn.dataset.unit, true);
        });
      });

      rateInput.addEventListener("input", updatePreview);
      categorySelect.addEventListener("change", onCategoryChange);

      onCategoryChange();
      syncRateUnit(rateUnitHidden.value || "hour", false);
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initRateUnitControls);
    } else {
      initRateUnitControls();
    }
  })();
</script>
