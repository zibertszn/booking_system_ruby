<!-- app/views/resources/index.html.erb — Каталог ресурсов -->
<div class="space-y-8">
  <!-- Заголовок и описание -->
  <section class="bg-white border border-slate-200 rounded-xl p-6 sm:p-8">
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div class="max-w-3xl">
        <h1 class="font-display text-2xl sm:text-4xl font-bold text-slate-900 tracking-tight" style="text-wrap: balance;">
          Сервис бронирования переговорных комнат, оборудования и специалистов
        </h1>
        <p class="mt-3 text-base text-slate-600 leading-relaxed">
          Выберите помещение, комплект оборудования или специалиста, проверьте свободные часы в расписании и оформите бронь онлайн.
        </p>
      </div>

      <div class="shrink-0">
        <a
          href="/resources/new"
          class="inline-flex items-center px-5 py-2.5 rounded-lg text-sm font-semibold bg-sky-600 hover:bg-sky-700 text-white transition-colors whitespace-nowrap"
        >
          + Добавить ресурс с фото
        </a>
      </div>
    </div>

    <!-- Панель фильтрации по категориям и поиска -->
    <div class="mt-6 pt-6 border-t border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-4">
      <div class="flex items-center gap-1 p-1 bg-slate-100 rounded-lg overflow-x-auto">
        <a
          href="/resources?category=all&q=<%= @search_query %>"
          class="px-3.5 py-1.5 text-xs font-medium rounded-md whitespace-nowrap shrink-0 transition-colors <%= @selected_category == 'all' ? 'bg-white text-slate-900 shadow-sm font-semibold' : 'text-slate-600 hover:text-slate-900' %>"
        >
          Все ресурсы
        </a>
        <a
          href="/resources?category=rooms&q=<%= @search_query %>"
          class="px-3.5 py-1.5 text-xs font-medium rounded-md whitespace-nowrap shrink-0 transition-colors <%= @selected_category == 'rooms' ? 'bg-white text-slate-900 shadow-sm font-semibold' : 'text-slate-600 hover:text-slate-900' %>"
        >
          Помещение
        </a>
        <a
          href="/resources?category=equipment&q=<%= @search_query %>"
          class="px-3.5 py-1.5 text-xs font-medium rounded-md whitespace-nowrap shrink-0 transition-colors <%= @selected_category == 'equipment' ? 'bg-white text-slate-900 shadow-sm font-semibold' : 'text-slate-600 hover:text-slate-900' %>"
        >
          Оборудование
        </a>
        <a
          href="/resources?category=specialists&q=<%= @search_query %>"
          class="px-3.5 py-1.5 text-xs font-medium rounded-md whitespace-nowrap shrink-0 transition-colors <%= @selected_category == 'specialists' ? 'bg-white text-slate-900 shadow-sm font-semibold' : 'text-slate-600 hover:text-slate-900' %>"
        >
          Специалисты
        </a>
      </div>

      <form action="/resources" method="get" class="flex items-center gap-2">
        <input type="hidden" name="category" value="<%= @selected_category %>">
        <input
          type="text"
          name="q"
          value="<%= @search_query %>"
          placeholder="Поиск по названию или оснащению..."
          class="w-full sm:w-64 px-3.5 py-1.5 text-sm border border-slate-300 rounded-lg text-slate-900 placeholder-slate-400 focus:outline-none focus:border-sky-600"
        >
        <button
          type="submit"
          class="px-4 py-1.5 text-xs font-semibold bg-slate-900 text-white rounded-lg hover:bg-slate-800 transition-colors whitespace-nowrap shrink-0"
        >
          Найти
        </button>
      </form>
    </div>
  </section>

  <!-- Сетка карточек ресурсов -->
  <% if @resources.any? %>
    <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @resources.each do |resource| %>
        <article class="bg-white border border-slate-200 rounded-xl overflow-hidden flex flex-col">
          <a href="/resources/<%= resource.slug %>" class="block h-48 bg-slate-900 overflow-hidden relative group flex items-center justify-center">
            <img
              src="<%= resource.image_url %>"
              alt="<%= resource.name %>"
              referrerpolicy="no-referrer"
              class="w-full h-full object-contain p-2 group-hover:scale-105 transition-transform"
            >
          </a>

          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <div class="text-xs text-slate-500">
                <span><%= resource.category_name %></span>
                <% if resource.capacity.present? && resource.capacity.to_i > 0 %>
                  <span aria-hidden="true">·</span>
                  <span>До <span class="font-mono tabular-nums"><%= resource.capacity %></span> чел.</span>
                <% end %>
              </div>

              <h2 class="mt-1.5 font-display text-lg font-bold text-slate-900">
                <a href="/resources/<%= resource.slug %>" class="hover:text-sky-700 transition-colors">
                  <%= resource.name %>
                </a>
              </h2>

              <div class="text-xs text-slate-500 mt-1">
                <%= resource.location %>
              </div>

              <p class="mt-2.5 text-sm text-slate-600 line-clamp-2 leading-relaxed">
                <%= resource.description %>
              </p>

              <% if resource.amenities.present? && resource.amenities.compact_blank.any? %>
                <div class="mt-3 text-xs text-slate-500">
                  <%= resource.amenities.join(" · ") %>
                </div>
              <% end %>
            </div>

            <div class="mt-5 pt-4 border-t border-slate-200 flex items-center justify-between gap-4">
              <div>
                <div class="text-xs text-slate-500">Тариф аренды</div>
                <div class="font-mono text-base font-bold text-slate-900 tabular-nums">
                  <%= number_with_delimiter(resource.hourly_rate) %> ₽ <span class="text-xs font-normal text-slate-500">/ <%= resource.rate_unit_label %></span>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <% if resource.owned_by?(current_user) %>
                  <a
                    href="<%= edit_resource_path(resource.slug) %>"
                    class="px-3 py-2 rounded-lg text-xs font-semibold text-sky-700 bg-sky-50 hover:bg-sky-100 border border-sky-200 transition-colors whitespace-nowrap shrink-0"
                  >
                    Редактировать
                  </a>
                <% end %>
                <a
                  href="/resources/<%= resource.slug %>"
                  class="px-4 py-2 rounded-lg text-xs font-semibold bg-sky-600 hover:bg-sky-700 text-white transition-colors whitespace-nowrap shrink-0"
                >
                  Выбрать время
                </a>
              </div>
            </div>
          </div>
        </article>
      <% end %>
    </section>
  <% else %>
    <section class="bg-white border border-slate-200 rounded-xl p-12 text-center">
      <h2 class="font-display text-lg font-bold text-slate-900">По вашему запросу ничего не найдено</h2>
      <p class="text-sm text-slate-600 mt-1">Попробуйте сбросить фильтры категории или поисковую строку.</p>
      <div class="mt-4">
        <a href="/resources" class="inline-block px-4 py-2 rounded-lg text-xs font-semibold bg-slate-900 text-white hover:bg-slate-800">
          Показать все ресурсы
        </a>
      </div>
    </section>
  <% end %>
</div>
